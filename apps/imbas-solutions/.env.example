# Copy to .env.local and fill in real values before deploying.

# Resend (https://resend.com) API key used by /api/contact to email new leads.
# Without this set, the contact form will show visitors a fallback
# "email us directly" message instead of silently failing.
RESEND_API_KEY=

# Where lead notifications are delivered.
CONTACT_EMAIL=hello@imbas.solutions

# Must be a verified sender/domain in your Resend account.
CONTACT_FROM_EMAIL=Imbas Solutions <onboarding@resend.dev>

# Canonical production URL, used for metadata, sitemap, and OG tags.
NEXT_PUBLIC_SITE_URL=https://imbas.solutions
